# ─────────────────────────────────────────────────────────────────────────────
# VitrinPlus — ortam değişkenleri (ÖRNEK). Bu dosyayı `.env.local` olarak kopyala ve doldur.
# `.env.local` dosyasını ASLA git'e ekleme. Gerçek anahtarları bu dosyaya YAZMA.
#
# Production'da eksik/geçersiz Supabase yapılandırması uygulamayı durdurur.
# Yalnızca development ortamında boş yapılandırma yerel demo moduna izin verir.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Dashboard → Project Settings → API → "anon" / "publishable" anahtarı (herkese açık; güvenlik RLS ile sağlanır)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# İsteğe bağlı yeni anahtar adı; doluysa ANON_KEY yerine kullanılır.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SEO canonical için gerçek production origin (ör. https://alan-adiniz).
# Vercel'de boşsa VERCEL_PROJECT_PRODUCTION_URL kullanılır.
NEXT_PUBLIC_SITE_URL=

# OAuth sağlayıcılarını Supabase Dashboard'da etkinleştirdikten SONRA "true" yap.
# "true" değilse giriş ekranındaki Google / Apple düğmeleri sahte bir giriş göstermez; "henüz etkin değil" der.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=
NEXT_PUBLIC_AUTH_APPLE_ENABLED=

# ── YALNIZCA SUNUCU (NEXT_PUBLIC_ öneki YOK, tarayıcıya asla gitmez) ─────────
# RLS'yi aşan service-role anahtarı. Şu an uygulamanın hiçbir akışı bunu kullanmıyor;
# ileride webhook / yönetim işleri için ayrılmıştır. Gerekmedikçe doldurma.
SUPABASE_SERVICE_ROLE_KEY=
